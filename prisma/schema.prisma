generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "sqlite"
 url = env("DATABASE_URL")
}
model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
}
model Batch {
  id String @id @default(cuid())
  name String @unique
  courseName String
  teacherName String
  timing String
  monthlyFee Int
  status String @default("Active")
  students Student[]
  createdAt DateTime @default(now())
}
model Student {
  id String @id @default(cuid())
  studentId String @unique
  name String
  parentName String
  mobile String
  batchId String
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  monthlyFee Int
  joiningDate DateTime
  status String @default("Active")
  fees Fee[]
  payments Payment[]
  createdAt DateTime @default(now())
}
model Fee {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  month String
  totalFee Int
  dueDate DateTime
  payments Payment[]
  @@unique([studentId, month])
}
model Payment {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeId String
  fee Fee @relation(fields: [feeId], references: [id], onDelete: Restrict)
  amount Int
  paymentDate DateTime
  mode String
  notes String @default("")
  receipt Receipt?
  createdAt DateTime @default(now())
}
model Receipt {
  id Int @id @default(autoincrement())
  number String @unique
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  remainingAmount Int
  createdAt DateTime @default(now())
}
